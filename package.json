{
  "name": "claude-cron",
  "version": "0.1.0",
  "type": "module",
  "bin": { "claude-cron": "./src/cli.ts" },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/claude-cron.js",
    "install:global": "chmod +x src/cli.ts && mkdir -p $HOME/.bun/bin && ln -sf \"$PWD/src/cli.ts\" \"$HOME/.bun/bin/claude-cron\" && echo 'claude-cron installed at' $HOME/.bun/bin/claude-cron"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.23.0",
    "yaml": "^2.5.0",
    "@iarna/toml": "^2.2.5",
    "cron-parser": "^4.9.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
